# Copie para .env e preencha. O .env NUNCA vai para o git.
# Gere os segredos com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=desenvolvimento
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=farias
DB_PASSWORD=
DB_NAME=farias
DB_POOL=10

# 48 bytes em hex. Trocar este valor derruba TODAS as sessões de uma vez.
JWT_SECRET=
SESSAO_TTL=3d

# Lista branca de origens, separadas por vírgula. Sem curinga.
CORS_ORIGENS=http://localhost:4200

# Intervalo de troca da oficina, em dias (medido na base: 219)
INTERVALO_DIAS=219

# Cache das agregações do painel, em ms
CACHE_PAINEL_MS=30000

# Consulta de placa por serviço externo: OPCIONAL, e por padrão DESLIGADA.
# Os serviços que devolvem motorização pedem CNPJ. Com isto vazio o sistema
# resolve pelo cadastro, pelo catálogo Wega e pelo histórico da própria
# oficina: placa desconhecida abre um campo pedindo o modelo e a resposta
# sai igual, de graça e sem internet. Veja o item 10a do INSTALACAO.md.
PLACA_API_URL=
PLACA_API_TOKEN=
PLACA_TIMEOUT_MS=8000
# Só para fornecedor que usa POST com token em cabeçalho (ex.: APIBrasil).
# Deixe vazio para fornecedor GET com token na URL (ex.: API Placas).
PLACA_API_METODO=
PLACA_API_CABECALHOS=
PLACA_API_CORPO=

# ===========================================================
# Inteligência Artificial — REVEZAMENTO
# A API tenta as IAs na ordem de IA_ORDEM. Se uma falhar (fora do ar,
# limite atingido, chave recusada), passa para a próxima sozinha.
# Só entra no revezamento quem tiver a chave preenchida: pode deixar
# vazias as que não for usar. O _MODEL é opcional (vazio = padrão).
# ===========================================================
IA_ORDEM=gemini,groq,cerebras,mistral,openrouter,deepseek,openai,anthropic

# Google Gemini — grátis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq — grátis com limite diário: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# Cerebras — grátis com limite diário: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Mistral — plano gratuito "Experiment": https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=

# OpenRouter — vários modelos numa chave; precisa de crédito, ou use um
# modelo terminado em :free no OPENROUTER_MODEL: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# DeepSeek — pago, muito barato: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# OpenAI — pago: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (Claude) — pago: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

